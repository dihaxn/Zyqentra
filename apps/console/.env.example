# Copy to .env.local. Never commit real values.

# Where the console reaches the OpenClaw Gateway (server side only; keep it on loopback or the tailnet).
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# Console sign-in: one shared team password, and a separate random secret for signing sessions.
# Generate both with `openssl rand -hex 32`.
CONSOLE_PASSWORD=
CONSOLE_SESSION_SECRET=

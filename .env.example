# Copy to .env (never commit .env). Used by scripts/dev-gateway.mjs and deploy/.

# Gateway access token. Long random string: `openssl rand -hex 32`.
OPENCLAW_GATEWAY_TOKEN=

# Model provider for the agents.
ANTHROPIC_API_KEY=

# Fine-grained GitHub token for zyqentra-github: dihaxn/Zyora-erp only,
# Issues read/write, Pull requests read/write, Contents read, Checks read, Deployments read.
# No admin, no workflow, no merge rights beyond what PR comments need.
ZYQENTRA_GITHUB_TOKEN=

# Absolute path of a dedicated Zyora-erp checkout the QA plugin may reset and test.
ZYQENTRA_QA_CHECKOUT=

# Optional: Vercel "Protection Bypass for Automation" secret, for smoke tests on protected previews.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Console sign-in (deploy/docker-compose.yml). Generate with `openssl rand -hex 32`.
CONSOLE_PASSWORD=
CONSOLE_SESSION_SECRET=
